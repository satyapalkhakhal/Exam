// prisma/schema.prisma
//
// Data model for the Arihant Recruitment Exam platform (design §11). Tables are
// snake_case in the DB, camelCase in the client; every PK is a UUID generated
// by Postgres; every FK is onDelete: Restrict except answer_versions ->
// answers (Cascade), so exam data can never vanish through a stray delete.
//
// Not modeled here, intentionally: the partial unique index
//   CREATE UNIQUE INDEX uq_exam_attempts_candidate_active
//     ON exam_attempts (candidate_id) WHERE status <> 'RESET';
// It enforces "one attempt per candidate unless reset" (a reset keeps the old
// row as RESET). Prisma cannot declare a partial unique index on an enum
// predicate, so it is appended as raw SQL to the _init migration; do not drop
// it when generating future migrations.
//
// activity_logs and admin_audit_logs are append-only: the app has no update or
// delete path for them.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // The compiled API runs as native Node ESM (dist/index.js), which does not
  // add ".js" to extensionless relative imports. These two settings make the
  // generated client emit "./enums.js"-style specifiers so `node dist/...`
  // can load it; tsx hid the problem in dev and tests.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  EVALUATOR
}

enum EmailTemplateKey {
  SUBMISSION_RECEIVED
  SHORTLISTED
  REJECTED
}

// HR's outcome for an application, kept apart from its exam progress (status).
enum CandidateResult {
  SHORTLISTED
  REJECTED
}

enum EmailDispatchStatus {
  QUEUED
  SENT
  FAILED
}

enum ImportKind {
  CANDIDATES
  QUESTIONS
}

// Placement (full-time) or internship hiring (spec 2026-11-10 colleges/drives).
enum JobProfileType {
  PLACEMENT
  INTERNSHIP
}

// Written (marked by an evaluator) or MCQ (4 options, one correct, auto-marked;
// spec 2026-11-10 MCQ questions).
enum QuestionType {
  WRITTEN
  MCQ
}

enum CandidateStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EVALUATED
  SHORTLISTED
  REJECTED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  RESET
}

enum SubmitType {
  MANUAL
  AUTO
}

enum LoginStage {
  LOGIN
  EXAM_START
}

enum LocationPermission {
  GRANTED
  DENIED
  UNAVAILABLE
  TIMEOUT
  UNSUPPORTED
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
}

enum AiRunStatus {
  RUNNING
  DONE
  CANCELLED
}

enum AiScoreStatus {
  QUEUED
  DONE
  FAILED
}

enum AiConfidence {
  LOW
  MEDIUM
  HIGH
}

model AdminUser {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique
  mobile           String?
  passwordHash     String    @map("password_hash")
  name             String
  role             AdminRole
  active           Boolean   @default(true)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  importBatches        ImportBatch[]
  questionEvaluations  QuestionEvaluation[]
  evaluatedAttempts    AttemptEvaluation[]      @relation("AttemptEvaluator")
  lockedAttempts       AttemptEvaluation[]      @relation("AttemptLocker")
  statusHistory        CandidateStatusHistory[]
  systemConfigsUpdated SystemConfig[]
  auditLogs            AdminAuditLog[]
  emailDispatches      EmailDispatch[]
  candidateResults     Candidate[]              @relation("CandidateResultBy")
  aiRuns               AiEvaluationRun[]

  @@map("admin_users")
}

// A job profile. Name is unique per type, case-insensitively, through the raw
// expression index job_roles_name_type_key (lower(name), type) in migration
// 20261110090000; Prisma cannot declare expression indexes.
model JobRole {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  type              JobProfileType @default(PLACEMENT)
  refApplicantCount Int            @default(0) @map("ref_applicant_count")
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  rounds     ExamRound[]
  candidates Candidate[]

  @@map("job_roles")
}

// An institution candidates come from. lower(name) and short_code are unique
// (raw indexes colleges_name_key / colleges_short_code_key).
model College {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  shortCode String   @map("short_code")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  drives Drive[]

  @@map("colleges")
}

// One test stage of a job profile: everything that is the same for every
// college (questions, duration, weights, the question lock).
model ExamRound {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobRoleId       String   @map("job_role_id") @db.Uuid
  roundNumber     Int      @map("round_number")
  name            String?
  durationMinutes Int      @default(60) @map("duration_minutes")
  questionsLocked Boolean  @default(false) @map("questions_locked")
  // Composite-score weights (docs/ai-evaluation.md); the four add up to 100.
  weightExam      Int      @default(70) @map("weight_exam")
  weightX         Int      @default(10) @map("weight_x")
  weightXii       Int      @default(10) @map("weight_xii")
  weightCpi       Int      @default(10) @map("weight_cpi")
  // Marks deducted per wrong MCQ answer (0 = no negative marking); frozen with the question lock.
  mcqNegativeMarks Decimal @default(0) @map("mcq_negative_marks") @db.Decimal(4, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  jobRole       JobRole       @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  questions     Question[]
  drives        Drive[]
  importBatches ImportBatch[]

  @@unique([jobRoleId, roundNumber])
  @@map("exam_rounds")
}

// One round at one college in one batch: the date/time window and the open
// switch. (round_id, college_id, lower(batch)) is unique through the raw index
// drives_round_college_batch_key.
model Drive {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId      String    @map("round_id") @db.Uuid
  collegeId    String    @map("college_id") @db.Uuid
  batch        String
  windowStart  DateTime? @map("window_start") @db.Timestamptz(6)
  windowEnd    DateTime? @map("window_end") @db.Timestamptz(6)
  isOpen       Boolean   @default(false) @map("is_open")
  instructions String    @default("")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  round         ExamRound         @relation(fields: [roundId], references: [id], onDelete: Restrict)
  college       College           @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  candidates    Candidate[]
  importBatches ImportBatch[]
  aiRuns        AiEvaluationRun[]

  @@index([roundId])
  @@index([collegeId])
  @@map("drives")
}

model Question {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId            String   @map("round_id") @db.Uuid
  type               QuestionType @default(WRITTEN)
  text               String
  // MCQ: exactly 4 options (A–D) and the index of the correct one; empty / null for written.
  options            String[] @default([])
  correctOption      Int?     @map("correct_option") @db.SmallInt
  // Written: hash of the text. MCQ: hash of the text and its 4 options.
  normalizedTextHash String   @map("normalized_text_hash")
  maxMarks           Decimal  @map("max_marks") @db.Decimal(8, 2)
  evaluatorGuidance  String?  @map("evaluator_guidance")
  displayOrder       Int      @default(0) @map("display_order")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  round            ExamRound         @relation(fields: [roundId], references: [id], onDelete: Restrict)
  attemptQuestions AttemptQuestion[]

  @@unique([roundId, normalizedTextHash])
  @@index([roundId, active, displayOrder])
  @@map("questions")
}

model ImportBatch {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind         ImportKind
  // QUESTIONS imports belong to a round, CANDIDATES imports to a drive.
  roundId      String?    @map("round_id") @db.Uuid
  driveId      String?    @map("drive_id") @db.Uuid
  fileName     String     @map("file_name")
  fileHash     String     @map("file_hash")
  uploadedById String     @map("uploaded_by_id") @db.Uuid
  total        Int        @default(0)
  imported     Int        @default(0)
  skipped      Int        @default(0)
  errors       Json       @default("[]")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  round      ExamRound?  @relation(fields: [roundId], references: [id], onDelete: Restrict)
  drive      Drive?      @relation(fields: [driveId], references: [id], onDelete: Restrict)
  uploadedBy AdminUser   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  candidates Candidate[]

  @@index([kind, createdAt])
  @@index([fileHash])
  @@index([uploadedById])
  @@index([roundId])
  @@index([driveId])
  @@map("import_batches")
}

// The person who signs in (docs/multi-exam.md). One account holds one
// application (a candidates row) per job role; email/mobile live here and are
// copied onto each application row.
model CandidateAccount {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  mobile    String?  @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  applications Candidate[]

  @@map("candidate_accounts")
}

// One application = (account x job role): code, status, marks, flags, history.
model Candidate {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId      String           @map("account_id") @db.Uuid
  candidateCode  String           @unique @map("candidate_code")
  fullName       String           @map("full_name")
  email          String
  mobile         String?
  rollNumber     String?          @map("roll_number")
  xPercentage    Decimal?         @map("x_percentage") @db.Decimal(5, 2)
  xiiPercentage  Decimal?         @map("xii_percentage") @db.Decimal(5, 2)
  majorCpi       Decimal?         @map("major_cpi") @db.Decimal(5, 2)
  discipline     String?
  programme      String?
  extra          Json             @default("{}")
  // Denormalised from drive -> round -> job role; always written together with driveId.
  jobRoleId      String           @map("job_role_id") @db.Uuid
  driveId        String           @map("drive_id") @db.Uuid
  // The Round 1 entry this entry was promoted from ("Move shortlisted to Round 2").
  promotedFromId String?          @map("promoted_from_id") @db.Uuid
  eligible       Boolean          @default(true)
  locationExempt Boolean          @default(false) @map("location_exempt")
  status         CandidateStatus  @default(NOT_STARTED)
  result         CandidateResult?
  resultAt       DateTime?        @map("result_at") @db.Timestamptz(6)
  resultById     String?          @map("result_by_id") @db.Uuid
  importBatchId  String?          @map("import_batch_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  account      CandidateAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  jobRole      JobRole                  @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  drive        Drive                    @relation(fields: [driveId], references: [id], onDelete: Restrict)
  promotedFrom Candidate?               @relation("PromotedFrom", fields: [promotedFromId], references: [id], onDelete: Restrict)
  promotedTo   Candidate[]              @relation("PromotedFrom")
  importBatch  ImportBatch?             @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  resultBy     AdminUser?               @relation("CandidateResultBy", fields: [resultById], references: [id], onDelete: Restrict)
  attempts     ExamAttempt[]
  activityLogs ActivityLog[]
  loginLogs    CandidateLoginLog[]
  history      CandidateStatusHistory[]
  emails       EmailDispatch[]

  @@unique([accountId, driveId])
  @@index([jobRoleId, status])
  @@index([jobRoleId, result])
  @@index([driveId, status])
  @@index([driveId, result])
  @@index([promotedFromId])
  @@index([resultById])
  @@index([importBatchId])
  @@index([rollNumber])
  @@index([email])
  @@index([mobile])
  @@map("candidates")
}

model ExamAttempt {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId     String        @map("candidate_id") @db.Uuid
  status          AttemptStatus @default(IN_PROGRESS)
  startedAt       DateTime      @map("started_at") @db.Timestamptz(6)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(6)
  submittedAt     DateTime?     @map("submitted_at") @db.Timestamptz(6)
  submitType      SubmitType?   @map("submit_type")
  activeSessionId String        @map("active_session_id")
  startIp         String        @map("start_ip")
  userAgent       String        @map("user_agent")
  totalMarks      Decimal?      @map("total_marks") @db.Decimal(8, 2)
  maxMarks        Decimal       @map("max_marks") @db.Decimal(8, 2)
  // Sum of the MCQ auto marks (set at submit) and their maximum.
  mcqMarks        Decimal?      @map("mcq_marks") @db.Decimal(8, 2)
  mcqMaxMarks     Decimal       @default(0) @map("mcq_max_marks") @db.Decimal(8, 2)
  percentage      Decimal?      @db.Decimal(5, 2)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate    Candidate          @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  questions    AttemptQuestion[]
  evaluation   AttemptEvaluation?
  activityLogs ActivityLog[]

  @@index([candidateId])
  @@index([status, endsAt])
  @@map("exam_attempts")
}

model AttemptQuestion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId        String   @map("attempt_id") @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  order            Int
  typeSnapshot     QuestionType @default(WRITTEN) @map("type_snapshot")
  textSnapshot     String   @map("text_snapshot")
  // MCQ: options in the order this candidate saw them, the correct index in that order,
  // the round's negative marking at start, and the auto mark set at submit.
  optionsSnapshot       String[] @default([]) @map("options_snapshot")
  correctSnapshot       Int?     @map("correct_snapshot") @db.SmallInt
  negativeMarksSnapshot Decimal  @default(0) @map("negative_marks_snapshot") @db.Decimal(4, 2)
  autoMarks             Decimal? @map("auto_marks") @db.Decimal(8, 2)
  maxMarksSnapshot Decimal  @map("max_marks_snapshot") @db.Decimal(8, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attempt    ExamAttempt         @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  question   Question            @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answer     Answer?
  evaluation QuestionEvaluation?
  aiScores   AiQuestionScore[]

  @@unique([attemptId, questionId])
  @@index([attemptId, order])
  @@index([questionId])
  @@map("attempt_questions")
}

model Answer {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptQuestionId String   @unique @map("attempt_question_id") @db.Uuid
  text              String   @default("")
  wordCount         Int      @default(0) @map("word_count")
  // MCQ choice (index in the shown order); null = not answered.
  selectedOption    Int?     @map("selected_option") @db.SmallInt
  clientSeq         Int      @default(0) @map("client_seq")
  lastSavedAt       DateTime @default(now()) @map("last_saved_at") @db.Timestamptz(6)
  markedForReview   Boolean  @default(false) @map("marked_for_review")
  visited           Boolean  @default(false)
  bulkInsertFlags   Int      @default(0) @map("bulk_insert_flags")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attemptQuestion AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Restrict)
  versions        AnswerVersion[]

  @@map("answers")
}

model AnswerVersion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  answerId  String   @map("answer_id") @db.Uuid
  text      String
  wordCount Int      @map("word_count")
  savedAt   DateTime @default(now()) @map("saved_at") @db.Timestamptz(6)

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId, savedAt])
  @@map("answer_versions")
}

model ActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  attemptId   String?  @map("attempt_id") @db.Uuid
  eventType   String   @map("event_type")
  questionId  String?  @map("question_id") @db.Uuid
  ip          String
  sessionId   String?  @map("session_id")
  userAgent   String?  @map("user_agent")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  candidate Candidate    @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  attempt   ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([attemptId, createdAt])
  @@index([candidateId, createdAt])
  @@index([eventType])
  @@map("activity_logs")
}

model CandidateLoginLog {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId   String             @map("candidate_id") @db.Uuid
  stage         LoginStage
  permission    LocationPermission
  latitude      Decimal?           @db.Decimal(9, 6)
  longitude     Decimal?           @db.Decimal(9, 6)
  accuracyM     Int?               @map("accuracy_m")
  ip            String
  userAgent     String             @map("user_agent")
  browser       String
  os            String
  deviceType    String             @map("device_type")
  sessionFamily String?            @map("session_family")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([candidateId, createdAt])
  @@index([ip])
  @@map("candidate_login_logs")
}

model QuestionEvaluation {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptQuestionId String   @unique @map("attempt_question_id") @db.Uuid
  marks             Decimal? @db.Decimal(8, 2)
  comment           String?
  evaluatorId       String   @map("evaluator_id") @db.Uuid
  // Set by bulk accept: the AI score this mark was taken from unchanged.
  aiScoreId         String?  @map("ai_score_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attemptQuestion AttemptQuestion  @relation(fields: [attemptQuestionId], references: [id], onDelete: Restrict)
  evaluator       AdminUser        @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)
  aiScore         AiQuestionScore? @relation(fields: [aiScoreId], references: [id], onDelete: Restrict)

  @@index([evaluatorId])
  @@index([aiScoreId])
  @@map("question_evaluations")
}

model AttemptEvaluation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId   String           @unique @map("attempt_id") @db.Uuid
  status      EvaluationStatus @default(DRAFT)
  evaluatorId String?          @map("evaluator_id") @db.Uuid
  lockedById  String?          @map("locked_by_id") @db.Uuid
  lockedAt    DateTime?        @map("locked_at") @db.Timestamptz(6)
  submittedAt DateTime?        @map("submitted_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  evaluator AdminUser?  @relation("AttemptEvaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)
  lockedBy  AdminUser?  @relation("AttemptLocker", fields: [lockedById], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([evaluatorId])
  @@index([lockedById])
  @@map("attempt_evaluations")
}

model CandidateStatusHistory {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String           @map("candidate_id") @db.Uuid
  fromStatus  CandidateStatus? @map("from_status")
  toStatus    CandidateStatus  @map("to_status")
  fromResult  CandidateResult? @map("from_result")
  toResult    CandidateResult? @map("to_result")
  byAdminId   String?          @map("by_admin_id") @db.Uuid
  comment     String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  candidate Candidate  @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  byAdmin   AdminUser? @relation(fields: [byAdminId], references: [id], onDelete: Restrict)

  @@index([candidateId, createdAt])
  @@index([byAdminId])
  @@map("candidate_status_history")
}

model SystemConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  value       Json
  isSecret    Boolean  @default(false) @map("is_secret")
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy AdminUser? @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([updatedById])
  @@map("system_configs")
}

// One row per manual candidate email (docs/email-templates.md). The rendered
// subject/html/text are stored so the record shows exactly what was sent; the
// purge script anonymises them with the candidate.
model EmailDispatch {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId     String              @map("batch_id") @db.Uuid
  template    EmailTemplateKey
  candidateId String              @map("candidate_id") @db.Uuid
  toEmail     String              @map("to_email")
  subject     String
  html        String
  text        String
  status      EmailDispatchStatus @default(QUEUED)
  error       String?
  attempts    Int                 @default(0)
  sentById    String              @map("sent_by_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz(6)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  sentBy    AdminUser @relation(fields: [sentById], references: [id], onDelete: Restrict)

  @@index([candidateId, template])
  @@index([batchId])
  @@index([status])
  @@index([sentById])
  @@index([createdAt])
  @@map("email_dispatches")
}

model AdminAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String?  @map("admin_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// One AI grading batch (docs/ai-evaluation.md). Counters and token totals are
// bumped by the worker; the run is DONE when done + failed = total.
model AiEvaluationRun {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The whole drive this run graded; null for a run on chosen submissions.
  driveId       String?     @map("drive_id") @db.Uuid
  model         String
  promptVersion String      @map("prompt_version")
  status        AiRunStatus @default(RUNNING)
  total         Int         @default(0)
  done          Int         @default(0)
  failed        Int         @default(0)
  inputTokens   Int         @default(0) @map("input_tokens")
  outputTokens  Int         @default(0) @map("output_tokens")
  createdById   String      @map("created_by_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt    DateTime?   @map("finished_at") @db.Timestamptz(6)

  drive     Drive?            @relation(fields: [driveId], references: [id], onDelete: Restrict)
  createdBy AdminUser         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  scores    AiQuestionScore[]

  @@index([driveId, createdAt])
  @@index([status])
  @@index([createdById])
  @@map("ai_evaluation_runs")
}

// One AI suggestion for one attempt question. The latest DONE row per attempt
// question is "the AI score"; older rows are kept as history. The rationale
// text is blanked by the purge script.
model AiQuestionScore {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId             String        @map("run_id") @db.Uuid
  attemptQuestionId String        @map("attempt_question_id") @db.Uuid
  status            AiScoreStatus @default(QUEUED)
  marks             Decimal?      @db.Decimal(8, 2)
  maxMarks          Decimal       @map("max_marks") @db.Decimal(8, 2)
  rationale         String?
  strengths         Json          @default("[]")
  improvements      Json          @default("[]")
  confidence        AiConfidence?
  concerns          String[]      @default([])
  model             String        @default("")
  inputTokens       Int           @default(0) @map("input_tokens")
  outputTokens      Int           @default(0) @map("output_tokens")
  error             String?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz(6)

  run             AiEvaluationRun      @relation(fields: [runId], references: [id], onDelete: Restrict)
  attemptQuestion AttemptQuestion      @relation(fields: [attemptQuestionId], references: [id], onDelete: Restrict)
  acceptedBy      QuestionEvaluation[]

  @@unique([runId, attemptQuestionId])
  @@index([attemptQuestionId, completedAt])
  @@index([runId, status])
  @@map("ai_question_scores")
}
