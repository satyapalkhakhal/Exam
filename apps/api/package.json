{
  "name": "@exam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env APP_ENV=local tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.test.json --noEmit",
    "test": "cross-env APP_ENV=test node --import tsx --import ./tests/setup.ts --test \"tests/*.test.ts\"",
    "test:int": "APP_ENV=test node --import tsx --test --test-concurrency=1 \"tests/integration/*.int.test.ts\"",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:test": "cross-env APP_ENV=test prisma migrate deploy",
    "seed": "tsx src/infrastructure/db/seed.ts",
    "admin:disable-integrations": "tsx src/scripts/disable-integrations.ts",
    "admin:reset-password": "tsx src/scripts/reset-admin-password.ts",
    "purge-candidates": "tsx src/scripts/purge-candidates.ts"
  },
  "dependencies": {
    "@exam/shared": "workspace:^",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^7.52.0",
    "pg": "^8.14.1",
    "prisma": "^7.8.0",
    "rate-limit-redis": "^4.2.0",
    "ua-parser-js": "^2.0.10",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/supertest": "^7.2.1",
    "ioredis-mock": "^8.13.1",
    "supertest": "^7.3.1",
    "tsx": "^4.20.3",
    "typescript": "5.8.3"
  }
}
