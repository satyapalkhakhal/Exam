# Copy to apps/api/.env.production (or .env.uat) ON THE SERVER ONLY. Never commit it.
# deploy-api.sh refuses to run while any value still contains '<' or 'changeme'.
# Use hex secrets (openssl rand -hex ...) so nothing needs URL-escaping in the two URLs below.

NODE_ENV=production
PORT=4100
# Loopback port nginx proxies to on the host (default: 4100 production, 4101 uat).
API_HOST_PORT=4100

# Postgres container credentials; DATABASE_URL must use the same user/password/db.
POSTGRES_USER=exam_user
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=exam_db
DATABASE_URL=postgresql://exam_user:<same as POSTGRES_PASSWORD>@exam_postgres:5432/exam_db

# Redis container password; REDIS_URL must use the same one.
REDIS_PASSWORD=<openssl rand -hex 24>
REDIS_URL=redis://:<same as REDIS_PASSWORD>@exam_redis:6379

# 32+ chars each, and the two must differ.
JWT_ADMIN_SECRET=<openssl rand -hex 64>
JWT_CANDIDATE_SECRET=<openssl rand -hex 64>
# 64 hex chars. Encrypts SMS/email secrets in the DB. Back it up: losing it means re-entering the credentials.
CONFIG_ENCRYPTION_KEY=<openssl rand -hex 32>

TRUST_PROXY=1
COOKIE_SECURE=true
PUBLIC_WEB_URL=https://exam.arihantcapital.com
CORS_ORIGIN=https://exam.arihantcapital.com
# Domain deploy-web.sh publishes to (/var/www/<this>). Ignored by the API.
EXAM_WEB_DOMAIN=exam.arihantcapital.com

# Static OTP 123456 while real SMS/email creds are not entered yet (unset = off).
# set to false before the live exam
ALLOW_STATIC_OTP=true
LOG_DIR=./logs

# Used once by the seed; change the password on first login.
SEED_ADMIN_EMAIL=<admin email>
SEED_ADMIN_PASSWORD=<strong password>
# Optional: 10-digit mobile, so the seeded admin also gets login codes by SMS.
SEED_ADMIN_MOBILE=
